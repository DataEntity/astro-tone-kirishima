---
import { render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getPublishedCollection } from '../../../../lib/content';
import { site } from '../../../../data/site';
import TextReveal from '../../../../components/islands/TextReveal.astro';
import Icon from '../../../../components/chrome/Icon.astro';
export async function getStaticPaths(){ const entries=await getPublishedCollection('projects'); return entries.map((entry)=>{const d=entry.data.publishedAt;return {params:{year:String(d.getFullYear()),month:String(d.getMonth()+1).padStart(2,'0'),slug:entry.id.replace(/^.*\//,'').replace(/\.(md|mdx)$/,'')},props:{entry}}}); }
const {entry}=Astro.props; const {Content}=await render(entry);
const textReveal = entry.data.textReveal ?? site.features.textReveal;
---
<BaseLayout title={`${entry.data.title} · Aeschion`} description={entry.data.description} canonical={entry.data.canonical} image={entry.data.ogImage}><article class="article narrow" data-text-reveal={textReveal ? 'true' : 'false'}><p class="eyebrow">{entry.data.status} · {entry.data.type}</p><h1 data-text-reveal-title>{entry.data.title}</h1><p class="dek" data-text-reveal-dek>{entry.data.description}</p><div class="prose" data-text-reveal-prose><Content/></div>{entry.data.externalUrl&&<a href={entry.data.externalUrl}>访问项目 <Icon name="arrowUpRight" size="sm" /></a>}</article><TextReveal /></BaseLayout>
<style>.article{padding:5rem 0}.article h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.dek{font-size:1.3rem;color:var(--muted)}</style>
