---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/blog/PostCard.astro";
import { getPublishedWriting } from "../lib/content";
const writing = await getPublishedWriting();
const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const normalizedQuery = query.toLowerCase();
const matches = (entry: (typeof writing)[number]) =>
  !normalizedQuery ||
  `${entry.data.title} ${entry.data.description} ${entry.data.tags.join(" ")} ${entry.body ?? ""}`
    .toLowerCase()
    .includes(normalizedQuery);
---

<BaseLayout title="搜索 · Fourfold" description="搜索标题、摘要、正文和标签。"
  ><section class="search-page narrow">
    <p class="eyebrow">Search</p><h1>从已经写下的，继续往前找。</h1><input
      id="search"
      type="search"
      value={query}
      placeholder="搜索文章与标签"
      autocomplete="off"
    /><p id="status" class="muted">{query ? `${writing.filter(matches).length} 个结果` : "输入关键词开始搜索。"}</p><div
      id="results"
      class="list">
      {
        writing.map((entry) => (
          <div
            data-search-item
            data-text={`${entry.data.title} ${entry.data.description} ${entry.data.tags.join(" ")} ${entry.body ?? ""}`}
            hidden={!matches(entry)}>
            <PostCard entry={entry} />
          </div>
        ))
      }
    </div>
  </section></BaseLayout
>
<script>
  const input = document.querySelector<HTMLInputElement>("#search");
  const items = [...document.querySelectorAll<HTMLElement>("[data-search-item]")];
  const status = document.querySelector<HTMLElement>("#status");
  const updateResults = () => {
    const q = input?.value.trim().toLowerCase() ?? "";
    let count = 0;
    items.forEach((item) => {
      const show = !q || Boolean(item.dataset.text?.toLowerCase().includes(q));
      item.hidden = !show;
      if (show) count++;
    });
    if (status) status.textContent = q ? `${count} 个结果` : "输入关键词开始搜索。";
  };
  input?.addEventListener("input", () => {
    updateResults();
    const q = input.value.trim().toLowerCase();
    const url = new URL(location.href);
    q ? url.searchParams.set("q", q) : url.searchParams.delete("q");
    history.replaceState({}, "", url);
  });
  const initialQuery = new URL(location.href).searchParams.get("q") ?? "";
  if (input && initialQuery) input.value = initialQuery;
  updateResults();
</script>
<style>
  .search-page {
    padding: 5rem 0;
  }
  .search-page h1 {
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.06em;
    margin: 0.5rem 0 2rem;
  }
  .search-page input {
    width: 100%;
    border: 0;
    border-bottom: 2px solid var(--ink);
    background: transparent;
    padding: 0.8rem 0;
    font-size: 1.4rem;
    outline: none;
  }
  .search-page input:focus {
    border-color: var(--accent);
  }
</style>
