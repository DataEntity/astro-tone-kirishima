---
import { render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TagList from '../../../../components/blog/TagList.astro';
import TextReveal from '../../../../components/islands/TextReveal.astro';
import { getPublishedCollection } from '../../../../lib/content';
import { site } from '../../../../data/site';
export async function getStaticPaths(){ const entries=await getPublishedCollection('research'); return entries.map((entry)=>{const d=entry.data.publishedAt;return {params:{year:String(d.getFullYear()),month:String(d.getMonth()+1).padStart(2,'0'),slug:entry.id.replace(/^.*\//,'').replace(/\.(md|mdx)$/,'')},props:{entry}}}); }
const {entry}=Astro.props; const {Content}=await render(entry);
const textReveal = entry.data.textReveal ?? site.features.textReveal;
---
<BaseLayout title={`${entry.data.title} · Fourfold`} description={entry.data.description} canonical={entry.data.canonical} image={entry.data.ogImage}><article class="article narrow" data-text-reveal={textReveal ? 'true' : 'false'}><p class="eyebrow">{entry.data.kind} · v{entry.data.version}</p><h1 data-text-reveal-title>{entry.data.title}</h1><p class="dek" data-text-reveal-dek>{entry.data.description}</p><TagList tags={entry.data.tags}/><div class="prose" data-text-reveal-prose><Content/></div></article><TextReveal /></BaseLayout>
<style>.article{padding:5rem 0}.article h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.dek{font-size:1.3rem;color:var(--muted)}</style>
