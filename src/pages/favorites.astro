---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="收藏 · Fourfold"
  ><section class="favorites narrow">
    <p class="eyebrow">Favorites</p><h1>留住想再读的。</h1><p class="muted">
      收藏只保存在当前浏览器，不需要账号，也不会上传。
    </p><div id="favorites-list"></div><button id="clear" hidden>清空全部</button>
  </section></BaseLayout
>
<script>
  const root = document.querySelector<HTMLElement>("#favorites-list");
  const clear = document.querySelector<HTMLButtonElement>("#clear");
  const key = "fourfold-favorites";
  const render = () => {
    let ids: string[] = [];
    try {
      const value = JSON.parse(localStorage.getItem(key) || "[]");
      if (Array.isArray(value)) ids = value.filter((id): id is string => typeof id === "string" && id.startsWith("/"));
    } catch {}
    if (root) {
      root.replaceChildren();
      if (ids.length) {
        ids.forEach((id) => {
          const paragraph = document.createElement("p");
          paragraph.className = "saved";
          const link = document.createElement("a");
          link.href = id;
          link.textContent = id;
          paragraph.append(link);
          root.append(paragraph);
        });
      } else {
        const empty = document.createElement("p");
        empty.className = "empty";
        empty.textContent = "还没有收藏。打开一篇文章，点击“收藏”即可。";
        root.append(empty);
      }
    }
    clear?.toggleAttribute("hidden", !ids.length);
  };
  clear?.addEventListener("click", () => {
    try {
      localStorage.removeItem(key);
    } catch {}
    render();
  });
  render();
</script>
<style>
  .favorites {
    padding: 5rem 0;
  }
  .favorites h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
    margin: 0.5rem 0;
  }
  .empty {
    border-block: 1px solid var(--line);
    padding: 2rem 0;
    color: var(--muted);
  }
  .saved {
    border-bottom: 1px solid var(--line);
    padding: 1rem 0;
  }
  .saved a {
    color: var(--accent);
  }
  button {
    border: 1px solid var(--line);
    background: none;
    padding: 0.5rem 0.8rem;
    cursor: pointer;
  }
</style>
