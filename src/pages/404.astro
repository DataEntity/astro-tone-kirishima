---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/urls";
import Icon from "../components/chrome/Icon.astro";
---

<BaseLayout title="404 · A Quiet Publication"
  ><section class="not-found narrow">
    <p class="eyebrow">404</p><h1>这页暂时不存在。</h1><p>
      <a href={sitePath("/")}>回到首页 <Icon name="arrowRight" size="sm" /></a>
    </p>
  </section></BaseLayout
>
<style>
  .not-found {
    padding: 8rem 0;
  }
  .not-found h1 {
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }
</style>
