---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/blog/PostCard.astro";
import { getPublishedWriting, getPublishedCollection, byDate, projectPath, researchPath } from "../lib/content";
import { site } from "../data/site";
import { sitePath } from "../lib/urls";
import Icon from "../components/chrome/Icon.astro";
const writing = await getPublishedWriting();
const featured = writing.filter((entry) => entry.data.featured).slice(0, 4);
const recent = writing.slice(0, 5);
const projects = byDate(await getPublishedCollection("projects")).slice(0, 2);
const research = byDate(await getPublishedCollection("research")).slice(0, 2);
---

<BaseLayout>
  <section class="hero container">
    <p class="eyebrow">Personal publication</p>
    <h1>{site.name}</h1>
    <p class="lede">{site.description}</p>
    <p class="author">{site.author.name} · {site.author.bio}</p>
  </section>
  <section class="container">
    <div class="section-heading">
      <h2><span>01 /</span> 写作</h2><a href={sitePath("/writing/")}
        >全部 {writing.length} 篇 <Icon name="arrowRight" size="sm" /></a>
    </div>
    {
      featured.length > 0 && (
        <>
          <>
            <p class="eyebrow sub">精选</p>
            <div class="list">
              {featured.map((entry) => (
                <PostCard entry={entry} />
              ))}
            </div>
          </>
        </>
      )
    }
    <p class="eyebrow sub">最近更新</p><div class="list">{recent.map((entry) => <PostCard entry={entry} />)}</div>
  </section>
  <section class="container split">
    <div>
      <div class="section-heading">
        <h2><span>02 /</span> 项目</h2><a href={sitePath("/projects/")}
          >查看全部 <Icon name="arrowRight" size="sm" /></a>
      </div>{
        projects.map((entry) => (
          <article>
            <>
              <p class="eyebrow">{entry.data.status}</p>
              <h3>
                <a href={projectPath(entry)}>{entry.data.title}</a>
              </h3>
              <p>{entry.data.description}</p>
            </>
          </article>
        ))
      }
    </div>
    <div>
      <div class="section-heading">
        <h2><span>03 /</span> 研究</h2><a href={sitePath("/research/")}
          >查看全部 <Icon name="arrowRight" size="sm" /></a>
      </div>{
        research.map((entry) => (
          <article>
            <>
              <p class="eyebrow">
                {entry.data.kind} · v{entry.data.version}
              </p>
              <h3>
                <a href={researchPath(entry)}>{entry.data.title}</a>
              </h3>
              <p>{entry.data.description}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="start container">
    <p class="eyebrow">04 / 从这里开始</p><h2>不确定从哪里读起？</h2><p>按问题、主题和阅读顺序找到适合自己的入口。</p><a
      href={sitePath("/start/")}>打开阅读地图 <Icon name="arrowRight" size="sm" /></a>
  </section>
</BaseLayout>
<style>
  .hero {
    padding: clamp(4rem, 10vw, 9rem) 0 5rem;
  }
  .hero h1 {
    font-size: clamp(4rem, 15vw, 10rem);
    line-height: 0.85;
    margin: 0.5rem 0 1.5rem;
    letter-spacing: -0.08em;
  }
  .lede {
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    max-width: 45rem;
    line-height: 1.25;
  }
  .author {
    color: var(--muted);
    max-width: 40rem;
  }
  .section-heading span {
    color: var(--accent);
    font-size: 0.8rem;
    font-family: ui-monospace, monospace;
  }
  .sub {
    margin-top: 2rem;
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .split article {
    border-bottom: 1px solid var(--line);
    padding: 1.3rem 0;
  }
  .split h3 {
    margin: 0.2rem 0;
    font-size: 1.3rem;
  }
  .split p:last-child {
    color: var(--muted);
  }
  .start {
    margin-top: 5rem;
    padding: 3rem 0;
    border-block: 1px solid var(--line);
  }
  .start h2 {
    font-size: clamp(2rem, 5vw, 4rem);
    margin: 0.4rem 0;
    letter-spacing: -0.05em;
  }
  @media (max-width: 48rem) {
    .split {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .hero {
      padding-top: 4rem;
    }
  }
</style>
