---
import { site } from '../data/site';
import { sitePath } from '../lib/urls';
const { title = site.title, description = site.description, image = '/og-default.svg', canonical, type = 'website', structuredData } = Astro.props;
const pathWithoutBase = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const url = new URL(sitePath(pathWithoutBase), site.url).toString();
const imageUrl = image.startsWith('http') ? image : new URL(sitePath(image), site.url).toString();
const structuredJson = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026') : '';
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="description" content={description} />
<link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
<link rel="canonical" href={canonical ?? url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical ?? url} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={sitePath('/rss.xml')} />
{structuredData && <script is:inline type="application/ld+json" set:html={structuredJson} />}
<title>{title}</title>
