---
type SpotifyKind = "playlist" | "album" | "track" | "artist" | "episode" | "show";

interface Props {
  /** Spotify ID，例如 playlist / album / track 的短 ID */
  id?: string;
  /** open.spotify.com 或 embed 完整链接；有 id 时优先用 id */
  src?: string;
  type?: SpotifyKind;
  /** 嵌入高度；playlist/album 常用 352，compact 可用 152 */
  height?: number | string;
  /** Spotify theme=0 为深色 */
  theme?: "light" | "dark";
  /** 外框圆角，单位 px。与 Spotify 卡片对齐时用 12 */
  radius?: number;
  title?: string;
  class?: string;
}

const {
  id,
  src,
  type = "playlist",
  height = 352,
  theme = "light",
  radius = 12,
  title = "Spotify playlist",
  class: className = "",
} = Astro.props;

function parseSpotifyInput(input: string): { kind: SpotifyKind; id: string } | null {
  const match = input.match(
    /(?:open\.spotify\.com\/(?:embed\/)?|spotify:)(playlist|album|track|artist|episode|show)[/:]([A-Za-z0-9]+)/i,
  );
  if (!match) return null;
  return {
    kind: match[1].toLowerCase() as SpotifyKind,
    id: match[2],
  };
}

const parsed = src ? parseSpotifyInput(src) : null;
const kind = (id ? type : parsed?.kind) ?? type;
const spotifyId = id ?? parsed?.id;

const embedSrc = spotifyId
  ? `https://open.spotify.com/embed/${kind}/${spotifyId}?utm_source=generator${
      theme === "dark" ? "&theme=0" : ""
    }`
  : null;
---

{
  embedSrc && (
    <div class:list={["spotify-embed", className]}>
      <iframe
        title={title}
        style={`border-radius:${radius}px;width:100%;height:${typeof height === "number" ? `${height}px` : height};border:0;`}
        src={embedSrc}
        width="100%"
        height={height}
        data-spotify-embed
        data-spotify-kind={kind}
        data-spotify-id={spotifyId}
        allowfullscreen
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      />
    </div>
  )
}

<script is:inline>
  (() => {
    const isDark = () => {
      const theme = document.documentElement.dataset.theme;
      if (theme === "dark") return true;
      if (theme === "light") return false;
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    };

    const syncSpotifyEmbeds = () => {
      const dark = isDark();
      document.querySelectorAll("[data-spotify-embed]").forEach((frame) => {
        const { spotifyKind, spotifyId } = frame.dataset;
        if (!spotifyKind || !spotifyId) return;
        const next = `https://open.spotify.com/embed/${spotifyKind}/${spotifyId}?utm_source=generator${dark ? "&theme=0" : ""}`;
        if (frame.getAttribute("src") !== next) frame.setAttribute("src", next);
      });
    };

    syncSpotifyEmbeds();

    if (!window.__spotifyThemeBound) {
      window.__spotifyThemeBound = true;
      new MutationObserver(syncSpotifyEmbeds).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", syncSpotifyEmbeds);
    }
  })();
</script>

<style>
  .spotify-embed {
    margin: 1.5rem 0;
    max-width: 100%;
  }

  .spotify-embed iframe {
    display: block;
    max-width: 100%;
  }
</style>
