<script>
  const CHAR_BUDGET = 720;
  const DURATION_MS = 1500;
  const HALF_MS = DURATION_MS / 2;
  const FLICKS = 3;
  const FLICK_MS = 42;
  const SETTLE_MS = 110;
  const TITLE_STAGGER_MS = 36;
  const BODY_STAGGER_MS = 18;
  const MARKS = Array.from(".,;:!?'\"()[]{}<>/\\|@#$%^&*-_=+~");
  const CLOSE_CHARS = new Set(Array.from('，。、；：？！…」』】》〉）)]}.,;:!?'));
  const OPEN_CHARS = new Set(Array.from('「『【《〈（([{‘“'));
  const SKIP = 'pre, code, kbd, samp, script, style, svg, math, img, picture, video, audio, iframe, canvas, object, embed, figure, figcaption, table, noscript, button, textarea, select, input, aside, ruby, rt, rp';
  const BLOCK = 'p, h1, h2, h3, h4, h5, h6, li, blockquote';

  type Grapheme = { segment: string; index: number };
  type CellPlan = { char: string; width: number };
  type Piece = { kind: 'text'; value: string } | { kind: 'atom'; cells: CellPlan[] };
  type Replacement = { parent: Node; nodes: Node[]; original: Text };
  type Session = { article: HTMLElement; timers: number[]; restore: () => void };

  const segmenter = typeof Intl !== 'undefined' && 'Segmenter' in Intl
    ? new Intl.Segmenter(undefined, { granularity: 'grapheme' })
    : null;

  let session: Session | null = null;

  const isSpace = (char: string) => /^\s$/u.test(char);
  const isAsciiWord = (char: string) => /^[A-Za-z0-9]$/.test(char);

  const pick = (previous: string) => {
    let index = Math.floor(Math.random() * MARKS.length);
    if (MARKS.length > 1 && MARKS[index] === previous) index = (index + 1) % MARKS.length;
    return MARKS[index] ?? '.';
  };

  const graphemeParts = (text: string): Grapheme[] => {
    if (segmenter) return Array.from(segmenter.segment(text), (part) => ({ segment: part.segment, index: part.index }));
    const parts: Grapheme[] = [];
    let index = 0;
    for (const segment of Array.from(text)) {
      parts.push({ segment, index });
      index += segment.length;
    }
    return parts;
  };

  const measureWidths = (textNode: Text, parts: Grapheme[], budgetLeft: number) => {
    const range = document.createRange();
    const widths: number[] = [];
    let counted = 0;
    for (const part of parts) {
      const end = part.index + part.segment.length;
      if (end > textNode.length) {
        widths.push(0);
        continue;
      }
      range.setStart(textNode, part.index);
      range.setEnd(textNode, end);
      const width = range.getBoundingClientRect().width;
      widths.push(width);
      if (!isSpace(part.segment) && width > 0) counted += 1;
      if (counted > budgetLeft) break;
    }
    return widths;
  };

  const shouldStick = (chars: string[], char: string, next: string | undefined) => {
    const prev = chars[chars.length - 1];
    if (!prev) return false;
    if (CLOSE_CHARS.has(char)) return true;
    if (OPEN_CHARS.has(prev)) return true;
    if ((char === "'" || char === '’') && isAsciiWord(prev) && !!next && isAsciiWord(next)) return true;
    if (isAsciiWord(char) && (isAsciiWord(prev) || prev === "'" || prev === '’' || prev === '.' || prev === ',')) return true;
    return false;
  };

  const planPieces = (parts: Grapheme[], widths: number[], budget: { left: number }): Piece[] => {
    const pieces: Piece[] = [];
    let atom: CellPlan[] = [];
    let raw = '';
    const flushRaw = () => {
      if (!raw) return;
      pieces.push({ kind: 'text', value: raw });
      raw = '';
    };
    const flushAtom = () => {
      if (!atom.length) return;
      flushRaw();
      pieces.push({ kind: 'atom', cells: atom });
      atom = [];
    };
    for (let index = 0; index < parts.length; index += 1) {
      const part = parts[index];
      if (!part) continue;
      const char = part.segment;
      const width = widths[index] ?? 0;
      if (isSpace(char)) {
        flushAtom();
        raw += char;
        continue;
      }
      if (!(width > 0)) {
        flushAtom();
        raw += char;
        continue;
      }
      if (budget.left <= 0) {
        flushAtom();
        raw += parts.slice(index).map((item) => item.segment).join('');
        break;
      }
      const chars = atom.map((item) => item.char);
      const next = parts[index + 1]?.segment;
      const stick = shouldStick(chars, char, next);
      const prev = chars[chars.length - 1] ?? '';
      const breakLongWord = stick && atom.length >= 24 && isAsciiWord(char) && !OPEN_CHARS.has(prev);
      if (atom.length && (!stick || breakLongWord)) flushAtom();
      budget.left -= 1;
      atom.push({ char, width });
    }
    flushAtom();
    flushRaw();
    return pieces;
  };

  const createCell = (char: string, width: number) => {
    const cell = document.createElement('span');
    cell.className = 'tr-cell';
    cell.dataset.phase = 'wait';
    cell.style.width = `${width}px`;
    const real = document.createElement('span');
    real.className = 'tr-real';
    real.textContent = char;
    const mask = document.createElement('span');
    mask.className = 'tr-mask';
    mask.setAttribute('aria-hidden', 'true');
    mask.dataset.p = pick('');
    cell.append(real, mask);
    return cell;
  };

  const renderPieces = (pieces: Piece[]) => {
    const nodes: Node[] = [];
    const cells: HTMLElement[] = [];
    const fragment = document.createDocumentFragment();
    for (const piece of pieces) {
      if (piece.kind === 'text') {
        const node = document.createTextNode(piece.value);
        nodes.push(node);
        fragment.append(node);
        continue;
      }
      const rendered = piece.cells.map((item) => {
        const cell = createCell(item.char, item.width);
        cells.push(cell);
        return cell;
      });
      const node = rendered.length === 1 ? rendered[0] : document.createElement('span');
      if (node instanceof HTMLElement && rendered.length > 1) {
        node.className = 'tr-atom';
        node.append(...rendered);
      }
      if (node) {
        nodes.push(node);
        fragment.append(node);
      }
    }
    return { nodes, cells, fragment };
  };

  const eligible = (textNode: Text) => {
    const parent = textNode.parentElement;
    if (!parent || !textNode.data) return false;
    if (parent.closest(SKIP)) return false;
    return !!parent.closest(BLOCK);
  };

  const textNodesIn = (root: HTMLElement) => {
    const nodes: Text[] = [];
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    let current = walker.nextNode();
    while (current) {
      if (current instanceof Text && eligible(current)) nodes.push(current);
      current = walker.nextNode();
    }
    return nodes;
  };

  const planRoot = (root: HTMLElement, budget: { left: number }) => {
    const jobs: { textNode: Text; pieces: Piece[] }[] = [];
    for (const textNode of textNodesIn(root)) {
      if (budget.left <= 0) break;
      const parts = graphemeParts(textNode.data);
      const widths = measureWidths(textNode, parts, budget.left);
      const pieces = planPieces(parts, widths, budget);
      if (pieces.some((piece) => piece.kind === 'atom')) jobs.push({ textNode, pieces });
    }
    return jobs;
  };

  const applyJobs = (jobs: { textNode: Text; pieces: Piece[] }[], records: Replacement[]) => {
    const cells: HTMLElement[] = [];
    for (const job of jobs) {
      const parent = job.textNode.parentNode;
      if (!parent) continue;
      const built = renderPieces(job.pieces);
      parent.insertBefore(built.fragment, job.textNode);
      job.textNode.remove();
      records.push({ parent, nodes: built.nodes, original: job.textNode });
      cells.push(...built.cells);
    }
    return cells;
  };

  const begin = (article: HTMLElement): Session => {
    const timers: number[] = [];
    const records: Replacement[] = [];
    let restored = false;
    const restore = () => {
      if (restored) return;
      restored = true;
      for (const record of records) {
        if (!record.parent.isConnected) continue;
        const live = record.nodes.filter((node) => node.parentNode === record.parent);
        if (!live.length) continue;
        const anchor = live[0];
        if (!anchor) continue;
        record.parent.insertBefore(record.original, anchor);
        for (const node of live) record.parent.removeChild(node);
      }
    };
    const active: Session = { article, timers, restore };
    article.dataset.textRevealDone = 'true';
    const budget = { left: CHAR_BUDGET };
    const title = article.querySelector<HTMLElement>('[data-text-reveal-title]');
    const dek = article.querySelector<HTMLElement>('[data-text-reveal-dek]');
    const prose = article.querySelector<HTMLElement>('[data-text-reveal-prose]');
    const titleJobs = title ? planRoot(title, budget) : [];
    const restJobs = [
      ...(dek ? planRoot(dek, budget) : []),
      ...(prose ? planRoot(prose, budget) : []),
    ];
    const titleCells = applyJobs(titleJobs, records);
    const restCells = applyJobs(restJobs, records);
    const cells = [...titleCells, ...restCells];
    const flickWindow = FLICKS * FLICK_MS;
    const titleLimit = Math.max(HALF_MS - flickWindow, 0);
    const bodyLimit = DURATION_MS - flickWindow;
    const schedule = (cell: HTMLElement, at: number) => {
      const mask = cell.querySelector<HTMLElement>('.tr-mask');
      if (!mask) return;
      let current = mask.dataset.p ?? '.';
      for (let step = 0; step < FLICKS; step += 1) {
        timers.push(window.setTimeout(() => {
          if (!cell.isConnected || cell.dataset.phase !== 'wait') return;
          current = pick(current);
          mask.dataset.p = current;
        }, at + step * FLICK_MS));
      }
      timers.push(window.setTimeout(() => {
        if (!cell.isConnected || cell.dataset.phase !== 'wait') return;
        cell.dataset.phase = 'set';
        cell.classList.add('is-set');
      }, at + flickWindow));
    };
    const titleSpan = Math.max(titleCells.length - 1, 0) * TITLE_STAGGER_MS;
    titleCells.forEach((cell, index) => {
      const at = titleSpan > titleLimit && titleCells.length > 1
        ? (index / (titleCells.length - 1)) * titleLimit
        : index * TITLE_STAGGER_MS;
      schedule(cell, at);
    });
    restCells.forEach((cell, index) => {
      const at = HALF_MS + index * BODY_STAGGER_MS;
      if (at > bodyLimit) return;
      schedule(cell, at);
    });
    timers.push(window.setTimeout(() => {
      if (!article.isConnected) return;
      for (const cell of cells) {
        if (cell.dataset.phase !== 'wait') continue;
        cell.dataset.phase = 'snap';
        cell.classList.add('is-snap');
      }
    }, DURATION_MS));
    timers.push(window.setTimeout(() => {
      if (session === active) teardown();
    }, DURATION_MS + SETTLE_MS));
    return active;
  };

  const teardown = () => {
    if (!session) return;
    const current = session;
    session = null;
    for (const id of current.timers) window.clearTimeout(id);
    current.timers.length = 0;
    current.restore();
  };

  const start = () => {
    const article = document.querySelector('article[data-text-reveal="true"]');
    if (!(article instanceof HTMLElement)) return;
    if (article.dataset.textRevealDone === 'true') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (session?.article === article) return;
    teardown();
    session = begin(article);
  };

  start();
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:after-swap', start);
  document.addEventListener('astro:before-preparation', teardown);
  document.addEventListener('astro:before-swap', teardown);
</script>

<style is:global>
  article[data-text-reveal='true'] .tr-cell {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    margin: 0;
    padding: 0;
    border: 0;
    letter-spacing: 0;
    white-space: pre;
    text-align: start;
  }
  article[data-text-reveal='true'] .tr-atom {
    display: inline;
    white-space: nowrap;
  }
  article[data-text-reveal='true'] .tr-real {
    color: transparent;
  }
  article[data-text-reveal='true'] .tr-cell.is-set .tr-real,
  article[data-text-reveal='true'] .tr-cell.is-snap .tr-real {
    color: inherit;
  }
  article[data-text-reveal='true'] .tr-cell.is-set .tr-real {
    animation: tr-land 110ms cubic-bezier(0.2, 0.85, 0.2, 1) both;
  }
  article[data-text-reveal='true'] .tr-mask {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    letter-spacing: 0;
    color: var(--muted);
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    white-space: pre;
  }
  article[data-text-reveal='true'] .tr-mask::before {
    content: attr(data-p);
  }
  article[data-text-reveal='true'] .tr-cell.is-set .tr-mask,
  article[data-text-reveal='true'] .tr-cell.is-snap .tr-mask {
    display: none;
  }
  @keyframes tr-land {
    from { transform: translateY(0.12em); }
    to { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    article[data-text-reveal='true'] .tr-real {
      color: inherit !important;
      animation: none !important;
    }
    article[data-text-reveal='true'] .tr-mask {
      display: none !important;
    }
  }
</style>
