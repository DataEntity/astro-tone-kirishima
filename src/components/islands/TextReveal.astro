<script>
  // Work stays capped at MAX_CELLS and at blocks in the viewport plus one screen.
  // The frame loop reads Flick state and writes mask text or is-set. It does not touch data attributes.
  const DURATION_MS = 1100;
  const FLICK_MS = 42;
  const SETTLE_MS = 110;
  const MAX_CELLS = 700;
  const WORD_LIMIT = 24;
  const MARKS = Array.from(".,;:!?'\"()[]{}<>/\\|@#$%^&*-_=+~");
  const CLOSE_CHARS = new Set(Array.from('，。、；：？！…」』】》〉）)]}.,;:!?'));
  const OPEN_CHARS = new Set(Array.from('「『【《〈（([{‘“'));
  const SKIP = 'pre, code, kbd, samp, script, style, svg, math, img, picture, video, audio, iframe, canvas, object, embed, figure, figcaption, table, noscript, button, textarea, select, input, aside, ruby, rt, rp';
  const BLOCK = 'p, h1, h2, h3, h4, h5, h6, li, blockquote';

  type CellPlan = { char: string; width: number };
  type Piece = { kind: 'text'; value: string } | { kind: 'atom'; cells: CellPlan[] };
  type Replacement = { parent: Node; nodes: Node[]; original: Text };
  type Session = { article: HTMLElement; frame: number; restore: () => void };
  type Sample = { font: string; spacing: number; size: number };
  type BuiltCell = { cell: HTMLElement; mask: HTMLElement; mark: string };
  type Flick = {
    cell: HTMLElement;
    mask: HTMLElement;
    settleAt: number;
    nextFlick: number;
    mark: string;
    waiting: boolean;
  };
  type Band = 'above' | 'view' | 'overscan' | 'below';

  const segmenter = typeof Intl !== 'undefined' && 'Segmenter' in Intl
    ? new Intl.Segmenter(undefined, { granularity: 'grapheme' })
    : null;

  const widthCache = new Map<string, number>();
  let measureCtx: CanvasRenderingContext2D | null | undefined;
  let session: Session | null = null;

  const isSpace = (char: string) => /^\s$/u.test(char);
  const isAsciiWord = (char: string) => /^[A-Za-z0-9]$/.test(char);

  const pick = (previous: string) => {
    let index = Math.floor(Math.random() * MARKS.length);
    if (MARKS.length > 1 && MARKS[index] === previous) index = (index + 1) % MARKS.length;
    return MARKS[index] ?? '.';
  };

  const graphemes = (text: string) => {
    if (segmenter) return Array.from(segmenter.segment(text), (part) => part.segment);
    return Array.from(text);
  };

  const measureContext = () => {
    if (measureCtx !== undefined) return measureCtx;
    measureCtx = document.createElement('canvas').getContext('2d');
    return measureCtx;
  };

  const sampleFor = (el: HTMLElement, samples: Map<HTMLElement, Sample>) => {
    const known = samples.get(el);
    if (known) return known;
    const style = getComputedStyle(el);
    const spacing = style.letterSpacing === 'normal' ? 0 : Number.parseFloat(style.letterSpacing) || 0;
    const sample = { font: style.font, spacing, size: Number.parseFloat(style.fontSize) || 16 };
    samples.set(el, sample);
    return sample;
  };

  const glyphWidth = (sample: Sample, segment: string) => {
    const key = `${sample.spacing}|${sample.font}|${segment}`;
    const cached = widthCache.get(key);
    if (cached !== undefined) return cached;
    const ctx = measureContext();
    let textWidth = 0;
    if (ctx) {
      ctx.font = sample.font;
      textWidth = ctx.measureText(segment).width;
    }
    if (!(textWidth > 0)) {
      const latin = /^[\u0000-\u00ff]+$/.test(segment);
      textWidth = sample.size * (latin ? 0.5 : 1);
    }
    const width = Math.max(Math.round((textWidth + sample.spacing) * 64) / 64, 1);
    widthCache.set(key, width);
    return width;
  };

  const shouldStick = (chars: string[], char: string, next: string | undefined) => {
    const prev = chars[chars.length - 1];
    if (!prev) return false;
    if (CLOSE_CHARS.has(char)) return true;
    if (OPEN_CHARS.has(prev)) return true;
    if ((char === "'" || char === '’') && isAsciiWord(prev) && !!next && isAsciiWord(next)) return true;
    if (isAsciiWord(char) && (isAsciiWord(prev) || prev === "'" || prev === '’' || prev === '.' || prev === ',')) return true;
    return false;
  };

  const planPieces = (text: string, sample: Sample, budget: { left: number }): Piece[] => {
    const parts = graphemes(text);
    const pieces: Piece[] = [];
    let atom: CellPlan[] = [];
    let raw = '';
    const flushRaw = () => {
      if (!raw) return;
      pieces.push({ kind: 'text', value: raw });
      raw = '';
    };
    const flushAtom = () => {
      if (!atom.length) return;
      flushRaw();
      pieces.push({ kind: 'atom', cells: atom });
      atom = [];
    };
    for (let index = 0; index < parts.length; index += 1) {
      const char = parts[index];
      if (!char) continue;
      if (isSpace(char)) {
        flushAtom();
        raw += char;
        continue;
      }
      const chars = atom.map((item) => item.char);
      const next = parts[index + 1];
      const stick = shouldStick(chars, char, next);
      const prev = chars[chars.length - 1] ?? '';
      const breakLongWord = stick && atom.length >= WORD_LIMIT && isAsciiWord(char) && !OPEN_CHARS.has(prev);
      if (atom.length && (!stick || breakLongWord)) flushAtom();
      const finishingWord = atom.length > 0 && budget.left > -WORD_LIMIT;
      if (budget.left <= 0 && !finishingWord) {
        flushAtom();
        raw += parts.slice(index).join('');
        break;
      }
      const width = glyphWidth(sample, char);
      if (!(width > 0)) {
        flushAtom();
        raw += char;
        continue;
      }
      atom.push({ char, width });
      budget.left -= 1;
    }
    flushAtom();
    flushRaw();
    return pieces;
  };

  const createCell = (char: string, width: number): BuiltCell => {
    const cell = document.createElement('span');
    cell.className = 'tr-cell';
    cell.style.width = `${width}px`;
    const real = document.createElement('span');
    real.className = 'tr-real';
    real.textContent = char;
    const mask = document.createElement('span');
    mask.className = 'tr-mask';
    mask.setAttribute('aria-hidden', 'true');
    const mark = pick('');
    mask.textContent = mark;
    cell.append(real, mask);
    return { cell, mask, mark };
  };

  const renderPieces = (pieces: Piece[]) => {
    const nodes: Node[] = [];
    const cells: BuiltCell[] = [];
    const fragment = document.createDocumentFragment();
    for (const piece of pieces) {
      if (piece.kind === 'text') {
        const node = document.createTextNode(piece.value);
        nodes.push(node);
        fragment.append(node);
        continue;
      }
      const rendered = piece.cells.map((item) => {
        const built = createCell(item.char, item.width);
        cells.push(built);
        return built.cell;
      });
      const node = rendered.length === 1 ? rendered[0] : document.createElement('span');
      if (node instanceof HTMLElement && rendered.length > 1) {
        node.className = 'tr-atom';
        node.append(...rendered);
      }
      if (node) {
        nodes.push(node);
        fragment.append(node);
      }
    }
    return { nodes, cells, fragment };
  };

  const eligible = (textNode: Text) => {
    const parent = textNode.parentElement;
    if (!parent || !textNode.data) return false;
    if (parent.closest(SKIP)) return false;
    return !!parent.closest(BLOCK);
  };

  const forText = (root: HTMLElement, visit: (textNode: Text) => boolean) => {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    let current = walker.nextNode();
    while (current) {
      if (current instanceof Text && eligible(current) && !visit(current)) return;
      current = walker.nextNode();
    }
  };

  const bandOf = (block: HTMLElement, viewBottom: number, limit: number, bands: Map<HTMLElement, Band>) => {
    const known = bands.get(block);
    if (known) return known;
    const rect = block.getBoundingClientRect();
    const band: Band = rect.bottom <= 0 ? 'above' : rect.top >= limit ? 'below' : rect.top >= viewBottom ? 'overscan' : 'view';
    bands.set(block, band);
    return band;
  };

  const collect = (
    root: HTMLElement,
    viewport: boolean,
    jobs: { textNode: Text; pieces: Piece[] }[],
    budget: { left: number },
    samples: Map<HTMLElement, Sample>,
    bands: Map<HTMLElement, Band>,
    viewBottom: number,
    limit: number,
  ) => {
    forText(root, (textNode) => {
      if (budget.left <= 0) return false;
      const parent = textNode.parentElement;
      if (!parent) return true;
      if (viewport) {
        const block = parent.closest(BLOCK);
        if (!(block instanceof HTMLElement)) return true;
        const band = bandOf(block, viewBottom, limit, bands);
        if (band === 'above') return true;
        if (band === 'below') return false;
        if (band === 'overscan' && textNode.data.length > budget.left) return false;
      }
      const pieces = planPieces(textNode.data, sampleFor(parent, samples), budget);
      if (pieces.some((piece) => piece.kind === 'atom')) jobs.push({ textNode, pieces });
      return true;
    });
  };

  const applyJobs = (jobs: { textNode: Text; pieces: Piece[] }[], records: Replacement[]) => {
    const cells: BuiltCell[] = [];
    for (const job of jobs) {
      const parent = job.textNode.parentNode;
      if (!parent) continue;
      const built = renderPieces(job.pieces);
      parent.insertBefore(built.fragment, job.textNode);
      job.textNode.remove();
      records.push({ parent, nodes: built.nodes, original: job.textNode });
      cells.push(...built.cells);
    }
    return cells;
  };

  let queued = 0;

  const cancelQueued = () => {
    if (!queued) return;
    cancelAnimationFrame(queued);
    queued = 0;
  };

  const begin = (article: HTMLElement): Session => {
    const records: Replacement[] = [];
    let restored = false;
    const restore = () => {
      if (restored) return;
      restored = true;
      for (const record of records) {
        if (!record.parent.isConnected) continue;
        const live = record.nodes.filter((node) => node.parentNode === record.parent);
        if (!live.length) continue;
        const anchor = live[0];
        if (!anchor) continue;
        record.parent.insertBefore(record.original, anchor);
        for (const node of live) record.parent.removeChild(node);
      }
    };
    const active: Session = { article, frame: 0, restore };
    article.dataset.textRevealDone = 'true';
    const title = article.querySelector<HTMLElement>('[data-text-reveal-title]');
    const dek = article.querySelector<HTMLElement>('[data-text-reveal-dek]');
    const prose = article.querySelector<HTMLElement>('[data-text-reveal-prose]');
    const jobs: { textNode: Text; pieces: Piece[] }[] = [];
    const budget = { left: MAX_CELLS };
    const samples = new Map<HTMLElement, Sample>();
    const bands = new Map<HTMLElement, Band>();
    const viewBottom = window.innerHeight || document.documentElement.clientHeight;
    const limit = viewBottom > 0 ? viewBottom * 2 : Number.POSITIVE_INFINITY;
    if (title) collect(title, false, jobs, budget, samples, bands, viewBottom, limit);
    if (dek) collect(dek, false, jobs, budget, samples, bands, viewBottom, limit);
    if (prose) collect(prose, true, jobs, budget, samples, bands, viewBottom, limit);
    const cells = applyJobs(jobs, records);
    if (!cells.length) return active;
    const half = DURATION_MS / 2;
    const items: Flick[] = cells.map((built) => ({
      cell: built.cell,
      mask: built.mask,
      settleAt: half + Math.random() * half,
      nextFlick: Math.random() * FLICK_MS,
      mark: built.mark,
      waiting: true,
    }));
    const started = performance.now();
    const drive = (now: number) => {
      if (session !== active) return;
      if (!article.isConnected) {
        session = null;
        return;
      }
      const elapsed = now - started;
      const closing = elapsed >= DURATION_MS;
      for (const item of items) {
        if (!item.waiting) continue;
        if (!closing && elapsed < item.settleAt) {
          if (elapsed >= item.nextFlick) {
            item.mark = pick(item.mark);
            item.mask.textContent = item.mark;
            item.nextFlick += FLICK_MS;
            if (item.nextFlick <= elapsed) item.nextFlick = elapsed + FLICK_MS;
          }
          continue;
        }
        item.waiting = false;
        item.cell.classList.add('is-set');
      }
      if (!closing || elapsed < DURATION_MS + SETTLE_MS) {
        active.frame = requestAnimationFrame(drive);
        return;
      }
      if (session === active) teardown();
    };
    active.frame = requestAnimationFrame(drive);
    return active;
  };

  const teardown = () => {
    cancelQueued();
    if (!session) return;
    const current = session;
    session = null;
    if (current.frame) cancelAnimationFrame(current.frame);
    try {
      current.restore();
    } catch {
      /* The page is navigating; a failed restore must not abort the route change. */
    }
  };

  const reveal = () => {
    const article = document.querySelector('article[data-text-reveal="true"]');
    if (!(article instanceof HTMLElement)) return;
    if (article.dataset.textRevealDone === 'true') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (session?.article === article) return;
    teardown();
    session = begin(article);
  };

  // Page-load runs after the route swap has committed. Two frames let that
  // transition paint before the matrix work starts, so the swap itself stays light.
  const start = () => {
    if (session && !session.article.isConnected) teardown();
    if (queued || session) return;
    queued = requestAnimationFrame(() => {
      queued = requestAnimationFrame(() => {
        queued = 0;
        try {
          reveal();
        } catch {
          teardown();
        }
      });
    });
  };

  start();
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-preparation', teardown);
</script>

<style is:global>
  article[data-text-reveal='true'] .tr-cell {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    margin: 0;
    padding: 0;
    border: 0;
    letter-spacing: 0;
    white-space: pre;
    text-align: start;
  }
  article[data-text-reveal='true'] .tr-atom {
    display: inline;
    white-space: nowrap;
  }
  article[data-text-reveal='true'] .tr-real {
    color: transparent;
  }
  article[data-text-reveal='true'] .tr-cell.is-set .tr-real,
  article[data-text-reveal='true'] .tr-cell.is-snap .tr-real {
    color: inherit;
  }
  article[data-text-reveal='true'] .tr-cell.is-set .tr-real {
    animation: tr-land 110ms cubic-bezier(0.2, 0.85, 0.2, 1) both;
  }
  article[data-text-reveal='true'] .tr-mask {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    letter-spacing: 0;
    color: var(--muted);
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    white-space: pre;
  }
  article[data-text-reveal='true'] .tr-cell.is-set .tr-mask,
  article[data-text-reveal='true'] .tr-cell.is-snap .tr-mask {
    display: none;
  }
  @keyframes tr-land {
    from { transform: translateY(0.12em); }
    to { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    article[data-text-reveal='true'] .tr-real {
      color: inherit !important;
      animation: none !important;
    }
    article[data-text-reveal='true'] .tr-mask {
      display: none !important;
    }
  }
</style>
