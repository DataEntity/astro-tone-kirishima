---
import Icon from '../chrome/Icon.astro';
const { id } = Astro.props;
---
<button class="favorite" data-favorite={id} aria-pressed="false"><Icon name="heart" /><span data-favorite-label>收藏</span></button>
<script>
  const favoriteKey = 'fourfold-favorites';
  const readFavorites = () => { try { const v = JSON.parse(localStorage.getItem(favoriteKey) || '[]'); return Array.isArray(v) ? v : []; } catch { return []; } };
  const bindFavorites = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-favorite]').forEach((button) => {
      if (button.dataset.favoriteBound === 'true') return;
      button.dataset.favoriteBound = 'true';
      const id = button.getAttribute('data-favorite');
      const label = button.querySelector<HTMLElement>('[data-favorite-label]');
      const update = () => { const active = readFavorites().includes(id); button.setAttribute('aria-pressed', String(active)); if (label) label.textContent = active ? '已收藏' : '收藏'; };
      button.addEventListener('click', () => {
        try {
          const list = readFavorites();
          const next = list.includes(id) ? list.filter((item) => item !== id) : [...list, id];
          localStorage.setItem(favoriteKey, JSON.stringify(next));
          update();
        } catch {
          if (label) label.textContent = '收藏不可用';
        }
      });
      update();
    });
  };
  bindFavorites();
  document.addEventListener('astro:page-load', bindFavorites);
</script>
<style>
  .favorite { display:inline-flex; align-items:center; gap:.4rem; border:1px solid var(--line); border-radius:999px; background:none; padding:.45rem .8rem; cursor:pointer; }
  .favorite[aria-pressed='true'] { color:var(--accent); border-color:var(--accent); }
</style>
